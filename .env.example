DATA_SOURCE=scylla
SCYLLA_CONTACT_POINTS=10.42.28.70
SCYLLA_PORT=9042
SCYLLA_KEYSPACE=hyperbase
SCYLLA_USERNAME=hyperbase
SCYLLA_PASSWORD=
SCYLLA_TABLE=records_91e2e000cb17494c8a45c6182b2a89ac
SCYLLA_COLLECTION_ID=91e2e000-cb17-494c-8a45-c6182b2a89ac
SCYLLA_QUERY_LIMIT=250000

MINIWEATHER_API_BASE_URL=http://miniweather-backend:3001
MINIWEATHER_AUTH_EMAIL=
MINIWEATHER_AUTH_PASSWORD=

RUN_INTERVAL_MINUTES=30
TIMEZONE=Asia/Jakarta
DRY_RUN=true
# Score only up to the last completed day (skip the still-running local day).
SKIP_PARTIAL_TODAY=true
# Min hours between warnings of the same level for the same hazard.
# Escalation (e.g. SIAGA -> AWAS) is always sent; downgrades are not sent.
ALERT_COOLDOWN_HOURS=12
# JSON file persisting the last posted level/time per hazard.
# Mount this path as a volume if you recreate the container and want to keep state.
ALERT_STATE_FILE=alert_state.json
STALE_AFTER_HOURS=48

RAIN_SIAGA_MM=50
RAIN_AWAS_MM=100
WIND_SIAGA_MS=10.8
WIND_AWAS_MS=17.2
